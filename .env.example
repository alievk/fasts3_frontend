# Torrent backend API configuration
# Base URL for the REST API (no trailing slash).
TORRENT_API_URL=http://localhost:8000/api
# Bearer token forwarded as Authorization header (leave blank if unauthenticated).
TORRENT_API_TOKEN=change-me

# Client registry (SQLite)
# Path to the shared SQLite database tracking client/job ownership.
TORRENT_CLIENT_DB_PATH=.cache/torrent-cli/clients.sqlite

# Search filters and timeouts
# Minimum/maximum torrent size (GiB) retained in search results.
TORRENT_SEARCH_MIN_SIZE_GIB=0.6
TORRENT_SEARCH_MAX_SIZE_GIB=5
# Milliseconds before aborting the /search request.
TORRENT_SEARCH_REQUEST_TIMEOUT_MS=10000

# Polling cadence for syncing job status (minimum enforced at 1000 ms).
TORRENT_CLI_POLL_MS=3000

# Telegram bot configuration
# Bot token provided by BotFather (required for `npm run bot`).
TORRENT_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Max search results fetched per query and page size for inline keyboards.
TORRENT_TELEGRAM_BOT_SEARCH_LIMIT=5
TORRENT_TELEGRAM_BOT_PAGE_SIZE=5
# Optional locale for bot responses (ru or en).
TORRENT_TELEGRAM_BOT_LOCALE=ru
# Translation bundle for bot responses: bot (default) or bot_fake.
TELEGRAM_LOCALE=bot

# Player frontend configuration
# Base URL used to build streaming links announced by the bot (no trailing slash).
PLAYER_BASE_URL=http://localhost:8080
