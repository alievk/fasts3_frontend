# Torrent backend API configuration
# Base URL for the REST API (no trailing slash).
API_URL=http://localhost:8000/api
# Bearer token forwarded as Authorization header (leave blank if unauthenticated).
API_TOKEN=change-me
# Global timezone for all Node processes (IANA name, e.g. UTC, Europe/Moscow).
TZ=UTC

# User registry (HTTP, Cloudflare D1)
# Provider selector (currently only d1).
USER_DB_PROVIDER=d1
# Cloudflare D1 credentials (required when using the D1 provider).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_D1_DATABASE_ID=your-database-id

# Search filters and timeouts
# Minimum/maximum torrent size (GiB) retained in search results.
SEARCH_MIN_SIZE_GIB=0.6
SEARCH_MAX_SIZE_GIB=5
# Minimum seeders required (results with fewer or unknown seeders are dropped).
SEARCH_MIN_SEEDERS=0
# Milliseconds before aborting the /search request.
SEARCH_REQUEST_TIMEOUT_MS=10000

# Polling cadence for syncing job status (minimum enforced at 1000 ms).
CLI_POLL_MS=3000

# Telegram bot configuration
# Bot token provided by BotFather (required for `npm run bot`).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Max search results fetched per query and page size for inline keyboards.
TELEGRAM_BOT_SEARCH_LIMIT=5
TELEGRAM_BOT_PAGE_SIZE=5
# Required default locale for bot responses (ru or en).
TELEGRAM_DEFAULT_BOT_LOCALE=ru
# Translation bundle for bot responses: bot (default) or bot_fake.
TELEGRAM_TRANSLATION_BUNDLE=bot

# Player frontend configuration
# Base URL used to build streaming links announced by the bot (no trailing slash).
PLAYER_BASE_URL=http://localhost:8080
